   "boundElements": null,
   "updated": 1751900000000,
   "link": null,
   "locked": false,
   "text": "Rail trace gpu1 <> gpu8 and SoftRoCE probe gpu1 <> gpu2. Known limits of the virtual platform: the RDMA plugin discovers no SoftRoCE device, pod-to-pod RoCE over the pods' own GIDs fails (kernel 6.8), RDMA CM from a pod is not run.",
   "fontSize": 12.5,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Rail trace gpu1 <> gpu8 and SoftRoCE probe gpu1 <> gpu2. Known limits of the virtual platform: the RDMA plugin discovers no SoftRoCE device, pod-to-pod RoCE over the pods' own GIDs fails (kernel 6.8), RDMA CM from a pod is not run.",
   "autoResize": true,
   "lineHeight": 1.25
  },
