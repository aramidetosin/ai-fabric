  {
   "id": "el-0316",
   "type": "text",
   "x": 40,
   "y": 60,
   "width": 3052.5000000000005,
   "height": 18.75,
   "angle": 0,
   "strokeColor": "#495057",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 5410,
   "version": 1,
   "versionNonce": 5417,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1751900000000,
   "link": null,
   "locked": false,
   "text": "One lane per flow, left to right, with the real hop names, interfaces and addresses of the traces. Frontend: VLAN 100 DATA 10.1.1.0/24 (VRF k8s, L2 VNI 10100, L3 VNI 11000), VLAN 200 STOR-MGMT 10.1.20.0/24 (L3 VNI 12000), VLAN 300 BASTION 10.1.30.0/24 (L3 VNI 13000). Backend: rail R = be-leaf R = VLAN R x 10 = 172.16.R.0/24. OOB 10.1.2.0/24. Management 172.21.21.0/24.",
   "fontSize": 15,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "One lane per flow, left to right, with the real hop names, interfaces and addresses of the traces. Frontend: VLAN 100 DATA 10.1.1.0/24 (VRF k8s, L2 VNI 10100, L3 VNI 11000), VLAN 200 STOR-MGMT 10.1.20.0/24 (L3 VNI 12000), VLAN 300 BASTION 10.1.30.0/24 (L3 VNI 13000). Backend: rail R = be-leaf R = VLAN R x 10 = 172.16.R.0/24. OOB 10.1.2.0/24. Management 172.21.21.0/24.",
   "autoResize": true,
   "lineHeight": 1.25
  },
