  {
   "id": "el-0002",
   "type": "text",
   "x": 40,
   "y": 60,
   "width": 2557.5,
   "height": 18.75,
   "angle": 0,
   "strokeColor": "#495057",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1014,
   "version": 1,
   "versionNonce": 1021,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1751900000000,
   "link": null,
   "locked": false,
   "text": "AI cluster POC under containerlab: Cisco Nexus 9300v frontend (VXLAN EVPN, vPC Fabric Peering), OcNOS rail backend (4 spines + 8 rail leaves), PA-VM firewall, Juniper vEX OOB switch, 6 control nodes, 32 simulated GPU nodes, a storage node, a bastion and 2 enterprise PCs. One Kubernetes cluster, domain lab.ai.",
   "fontSize": 15,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "AI cluster POC under containerlab: Cisco Nexus 9300v frontend (VXLAN EVPN, vPC Fabric Peering), OcNOS rail backend (4 spines + 8 rail leaves), PA-VM firewall, Juniper vEX OOB switch, 6 control nodes, 32 simulated GPU nodes, a storage node, a bastion and 2 enterprise PCs. One Kubernetes cluster, domain lab.ai.",
   "autoResize": true,
   "lineHeight": 1.25
  },
