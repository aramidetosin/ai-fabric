   "link": null,
   "locked": false,
   "text": "underlay: OSPF area 0 on IP unnumbered links (loopback0), hello 1 s / dead 3 s, one link per spine   |   overlay: iBGP EVPN AS 65100, spines = route reflectors, ingress replication\nanycast gateway = the subnet's .1 on every leaf, MAC 000a.00c1.0001   |   vPC domains: 1 = fe-gpu-leaf1/2, 2 = fe-gpu-leaf3/4, 3 = fe-ctrl-leaf1/2   |   server ports: LACP, rate fast",
   "fontSize": 13,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "underlay: OSPF area 0 on IP unnumbered links (loopback0), hello 1 s / dead 3 s, one link per spine   |   overlay: iBGP EVPN AS 65100, spines = route reflectors, ingress replication\nanycast gateway = the subnet's .1 on every leaf, MAC 000a.00c1.0001   |   vPC domains: 1 = fe-gpu-leaf1/2, 2 = fe-gpu-leaf3/4, 3 = fe-ctrl-leaf1/2   |   server ports: LACP, rate fast",
   "autoResize": true,
   "lineHeight": 1.25
