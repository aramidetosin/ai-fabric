   "boundElements": null,
   "updated": 1751900000000,
   "link": null,
   "locked": false,
   "text": "nodes: ctrl1-3 control-plane, ctrl4-6 worker, gpu1-32 gpu, storage\npods 10.42.0.0/16, services 10.43.0.0/16, geneve between nodes\nCilium devices bond0, bond0.100; node MTU 9000\nrails: Multus macvlan net-rail-0..7 (whereabouts), SoftRoCE rxe_gpu0..7\nLonghorn (RWX = share-manager, NFS); Harbor on ctrl4-6; MinIO S3 on the storage node\nlanguage model: llama-server on gpu2 / gpu25 + RPC workers over rails 3 / 6 (Service llm)\n= a model of the inference gateway (Envoy > APISIX > LiteLLM > east-west to the GPU nodes)\nDNS for every name: dns-b 10.80.15.53",
   "fontSize": 12.5,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "nodes: ctrl1-3 control-plane, ctrl4-6 worker, gpu1-32 gpu, storage\npods 10.42.0.0/16, services 10.43.0.0/16, geneve between nodes\nCilium devices bond0, bond0.100; node MTU 9000\nrails: Multus macvlan net-rail-0..7 (whereabouts), SoftRoCE rxe_gpu0..7\nLonghorn (RWX = share-manager, NFS); Harbor on ctrl4-6; MinIO S3 on the storage node\nlanguage model: llama-server on gpu2 / gpu25 + RPC workers over rails 3 / 6 (Service llm)\n= a model of the inference gateway (Envoy > APISIX > LiteLLM > east-west to the GPU nodes)\nDNS for every name: dns-b 10.80.15.53",
   "autoResize": true,
   "lineHeight": 1.25
  },
