# ai-fabric lab secrets -- copy to .env, set every value, then `set -a; . ./.env; set +a` before ./up.sh
# .env is gitignored. NOTHING here is a real credential: the published copy was sanitised.

# --- guest / appliance logins the lab creates --------------------------------------------------
# Both default to 'admin' (the containerlab convention) if left empty, so the lab deploys
# out of the box. Set them to something of your own for anything less throwaway.
LAB_ROOT_PASSWORD=admin            # root on the bastion, the PCs and the VM guests
LAB_ADMIN_PASSWORD=admin           # admin on the bastion, the PCs and the VM guests

# --- Kubernetes bootstrap (kubeadm) ------------------------------------------------------------
# These two have NO usable default - kubeadm rejects the placeholder. Generate both:
LAB_JOIN_TOKEN=                    # kubeadm token generate   (or: printf '%s.%s' $(openssl rand -hex 3) $(openssl rand -hex 8))
LAB_CERT_KEY=                      # openssl rand -hex 32     -> 64 hex characters

# --- your SSH keys ------------------------------------------------------------------------------
# Put your public key(s) in common/authorized_keys, ONE PER LINE, and nothing else -- operator keys
# only (a git deploy key in there will be handed to the switches). Two roles matter:
#   * the LAB HOST's own root key  -> NX-OS user `ops`, which nx-wait.sh and lib.sh NX() log in with.
#     Recognised by its `root@<host>` COMMENT, so append /root/.ssh/id_ed25519.pub (which carries the
#     comment) -- not `ssh-keygen -y` output, which prints the key without one. If your host key's
#     comment is not root@..., name it in LAB_HOST_KEY_COMMENT below.
#   * your workstation key         -> NX-OS user `admin`. NX-OS allows a single sshkey per user, so
#     name its comment here. Empty = the first key that is not the host key.
LAB_WORKSTATION_KEY_COMMENT=       # e.g. you@your-laptop
LAB_HOST_KEY_COMMENT=              # usually left empty: any root@... key in the file is used

# --- Palo Alto firewall -------------------------------------------------------------------------
# The PA-VM admin password you set on its first boot. Needed by fw-*.sh and the firewall API
# checks in validate-all.sh; those parts are skipped when it is unset.
FW_PASS=

# --- Nexus Dashboard / NDFC user (only with the ndfc=True profile flag) -------------------------
# gen.py ships a placeholder hash. Replace NDFC_USER with the NX-OS type-5 hash of your own
# password: on any N9Kv run `username <u> password <p> role network-admin`, then copy the
# generated `password 5 $5$...` line out of `show running-config`.

# --- the lab's model / Open WebUI ---------------------------------------------------------------
# Nothing here is required: by default Open WebUI talks to the model the lab serves itself on the GPU
# nodes (./post-deploy.sh -> llm-serve.sh), so the lab needs no external API key anywhere.
WEBUI_API_BASE=                    # empty = http://llm.ai-sim.svc.cluster.local:8080/v1 (the lab's own model)
WEBUI_MODEL=                       # empty = qwen2.5-0.5b-instruct, the alias llm-serve.sh serves it under
# Only the OPTIONAL inference gateway (./post-deploy.sh --gateway) reaches OpenRouter, and it asks for
# the key on the terminal rather than reading it from here. Nothing in the lab needs this variable.
OPENROUTER_API_KEY=                # leave empty unless your own tooling wants it; never commit a real value

# --- vendor network-OS images (LICENSED - build your own with vrnetlab) ------------------------
# No vendor image name or version ships in this repo. Obtain each qcow2 from the vendor, build the
# container with vrnetlab (https://github.com/hellt/vrnetlab) and put YOUR tag here. Unset values
# become SET_IN_ENV/... so a deploy fails loudly instead of pointing at an image you do not have.
VEX_IMAGE=                         # Juniper vJunos-switch  (OOB switch)
CVX_IMAGE=                         # NVIDIA Cumulus VX      (frontend, non-nx profiles)
OCNOS_IMAGE=                       # IP Infusion OcNOS      (8-rail backend)
PAN_IMAGE=                         # Palo Alto PA-VM        (firewall)
NX_IMAGE=                          # Cisco Nexus 9300v      (frontend, -nx profiles)
NX_BIN=                            # the NX-OS .bin filename inside NX_IMAGE
