# ai-fabric on site-b: passwordless SSH from the Mac to every node through site-b (the lab's management subnet 172.21.21.0/24 is
# routed to the office from this Mac, so a jump host is needed). Use:  echo 'Include ~/.ssh/ai-fabric-site-b' >> ~/.ssh/config  (top of file),
# copy this file to ~/.ssh/ai-fabric-site-b, then e.g.  ssh he-fe-spine1   ssh he-be-leaf1   ssh he-gpu17
Host he-*
    ProxyJump site-b
    User admin
    StrictHostKeyChecking no
    UserKnownHostsFile /dev/null
    LogLevel ERROR

