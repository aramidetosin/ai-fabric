[Unit]
Description=ai-fabric cluster self-bootstrap (kubeadm init/join, Cilium, cert-manager, Gateway, demo)
After=ai-fabric-netsetup.service containerd.service network.target
# containerd is Wants=, not Requires=: restarting containerd (registry-mirrors.sh does, once, when it first writes the
# mirror config) would otherwise STOP this unit with it -- systemd then restarts it, it restarts containerd again, and
# the bootstrap dies on start-limit-hit before kubeadm ever runs. After= still orders it behind containerd.
Requires=ai-fabric-netsetup.service
Wants=containerd.service

[Service]
Environment=HOME=/root
Type=simple
ExecStart=/usr/local/bin/cluster-bootstrap.sh
Restart=on-failure
RestartSec=20
StandardOutput=append:/var/log/ai-fabric-bootstrap.log
StandardError=append:/var/log/ai-fabric-bootstrap.log

[Install]
WantedBy=multi-user.target
