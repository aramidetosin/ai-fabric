   "roundness": null,
   "seed": 15686,
   "version": 1,
   "versionNonce": 15693,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1751900000000,
   "link": null,
   "locked": false,
   "text": "Every grey line = 4 x 800G ROUTED links (3.2 Tb/s per leaf-spine pair), each its own eBGP + BFD session, BGP unnumbered. Leaf uplinks ethernet48..63 = 16 x 800G = 12.8 Tb/s = the 32 x 400G facing the GPUs: 1:1, non-blocking.",
   "fontSize": 17,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Every grey line = 4 x 800G ROUTED links (3.2 Tb/s per leaf-spine pair), each its own eBGP + BFD session, BGP unnumbered. Leaf uplinks ethernet48..63 = 16 x 800G = 12.8 Tb/s = the 32 x 400G facing the GPUs: 1:1, non-blocking.",
   "autoResize": true,
   "lineHeight": 1.25
  },
