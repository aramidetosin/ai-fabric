   "boundElements": null,
   "updated": 1751900000000,
   "link": null,
   "locked": false,
   "text": "every leaf to both spines:\n2 x 400G to EACH spine = 4 x 400G per leaf\n(1.6 Tb/s up vs 16 x 100G down: 1:1),\nOSPF unnumbered underlay, iBGP EVPN overlay,\nthe spines are route reflectors",
   "fontSize": 13,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "every leaf to both spines:\n2 x 400G to EACH spine = 4 x 400G per leaf\n(1.6 Tb/s up vs 16 x 100G down: 1:1),\nOSPF unnumbered underlay, iBGP EVPN overlay,\nthe spines are route reflectors",
   "autoResize": true,
   "lineHeight": 1.25
  },
