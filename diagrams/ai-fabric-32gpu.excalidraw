  {
   "id": "el-1050",
   "type": "text",
   "x": 2300,
   "y": 1648,
   "width": 2094.4,
   "height": 21.25,
   "angle": 0,
   "strokeColor": "#d9480f",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
