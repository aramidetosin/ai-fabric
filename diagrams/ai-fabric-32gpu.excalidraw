   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "el-1110",
   "type": "text",
   "x": 56,
   "y": 1417,
   "width": 537.6,
   "height": 210.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 16526,
   "version": 1,
   "versionNonce": 16533,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1751900000000,
   "link": null,
   "locked": false,
   "text": "GPU links        32 nodes x 8 rails = 256 x 400G\nper rail leaf    down 32 x 400G = 12.8 Tb/s\n                 up   16 x 800G = 12.8 Tb/s   > 1:1\n                 32 of 64 ports used\nper spine        8 x 4 x 800G = 25.6 Tb/s, 32 of 64 ports\nleaf-spine       8 x 4 x 4 = 128 x 800G links\ncross-rail       102.4 Tb/s leaf-to-spine in total\nfrontend         32 x 2 x 100G = 64 x 100G GPU-node links,\n                 16 native 100G per GPU leaf, 2 GPU leaf pairs\n                 control leaf pair: 7 x 2 x 100G control/bastion\n                 + FlashBlade 8 x 100G data + 2 x 1G mgmt\n                 = 12 ports per leaf",
   "fontSize": 14,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "GPU links        32 nodes x 8 rails = 256 x 400G\nper rail leaf    down 32 x 400G = 12.8 Tb/s\n                 up   16 x 800G = 12.8 Tb/s   > 1:1\n                 32 of 64 ports used\nper spine        8 x 4 x 800G = 25.6 Tb/s, 32 of 64 ports\nleaf-spine       8 x 4 x 4 = 128 x 800G links\ncross-rail       102.4 Tb/s leaf-to-spine in total\nfrontend         32 x 2 x 100G = 64 x 100G GPU-node links,\n                 16 native 100G per GPU leaf, 2 GPU leaf pairs\n                 control leaf pair: 7 x 2 x 100G control/bastion\n                 + FlashBlade 8 x 100G data + 2 x 1G mgmt\n                 = 12 ports per leaf",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "el-1111",
   "type": "rectangle",
   "x": 800,
   "y": 1513,
   "width": 1420,
   "height": 520,
   "angle": 0,
   "strokeColor": "#2f9e44",
   "backgroundColor": "#f4fce3",
   "fillStyle": "solid",
