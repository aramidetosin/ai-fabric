  {
   "id": "el-1101",
   "type": "text",
   "x": 56,
   "y": 1235,
   "width": 686.4000000000001,
   "height": 60.0,
   "angle": 0,
   "strokeColor": "#343a40",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 16400,
   "version": 1,
   "versionNonce": 16407,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1751900000000,
   "link": null,
   "locked": false,
   "text": "ConnectX-8 in Ethernet mode = 2 x 400G per NIC. One 400G per plane; plane 1 only, no plane 2 for now.\n8 single-homed rail NICs, no bonding. MTU 9000 on the host, RoCEv2. n = node number 1..32.\nFrontend: bond0 = 2 x 100G LACP, vPC across the pair, one leg per leaf.   BMC: 1 port to the OOB switch.\nKubernetes: Multus + whereabouts give pods one interface per rail, pod range 172.16.N.100-199.",
   "fontSize": 12,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "ConnectX-8 in Ethernet mode = 2 x 400G per NIC. One 400G per plane; plane 1 only, no plane 2 for now.\n8 single-homed rail NICs, no bonding. MTU 9000 on the host, RoCEv2. n = node number 1..32.\nFrontend: bond0 = 2 x 100G LACP, vPC across the pair, one leg per leaf.   BMC: 1 port to the OOB switch.\nKubernetes: Multus + whereabouts give pods one interface per rail, pod range 172.16.N.100-199.",
   "autoResize": true,
   "lineHeight": 1.25
  },
