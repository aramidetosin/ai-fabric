  },
  {
   "id": "el-1112",
   "type": "text",
   "x": 816,
   "y": 1523,
   "width": 326.70000000000005,
   "height": 22.5,
   "angle": 0,
   "strokeColor": "#2b8a3e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
