   "boundElements": null,
   "updated": 1751900000000,
   "link": null,
   "locked": false,
   "text": "GPU node frontend: 2 x 100G per server, LACP bond0\nas a vPC. 32 nodes over TWO GPU leaf pairs:\ngpu1-16 on leaf1/2, gpu17-32 on leaf3/4 = 16 native\n100G server ports per leaf (QSFP28 in QSFP-DD ports,\nno breakout); all in <data VLAN>.",
   "fontSize": 12,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "GPU node frontend: 2 x 100G per server, LACP bond0\nas a vPC. 32 nodes over TWO GPU leaf pairs:\ngpu1-16 on leaf1/2, gpu17-32 on leaf3/4 = 16 native\n100G server ports per leaf (QSFP28 in QSFP-DD ports,\nno breakout); all in <data VLAN>.",
   "autoResize": true,
   "lineHeight": 1.25
  },
