   "isDeleted": false,
   "boundElements": null,
   "updated": 1751900000000,
   "link": null,
   "locked": false,
   "text": "border pair: VRF-lite handoff, one dot1q sub-interface\nand eBGP session per VRF (k8s, stor-mgmt, bastion).\nEach VRF's default route from the firewall becomes an\nEVPN type-5 route for every leaf. Not a vPC pair (L3 only).",
   "fontSize": 12,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "border pair: VRF-lite handoff, one dot1q sub-interface\nand eBGP session per VRF (k8s, stor-mgmt, bastion).\nEach VRF's default route from the firewall becomes an\nEVPN type-5 route for every leaf. Not a vPC pair (L3 only).",
   "autoResize": true,
   "lineHeight": 1.25
  },
