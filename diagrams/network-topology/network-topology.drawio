            <mxPoint x="2345" y="1710" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="item-136" value="Source: existing production physical design and cabling matrices. This diagram intentionally does not substitute the virtual lab’s IPs or switch models." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=19;fontColor=#53657E;fontStyle=0;fontFamily=Arial;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="55" y="1728" width="2280" height="28.32" as="geometry" />
        </mxCell>
