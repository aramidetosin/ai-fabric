        <mxCell id="item-130" value="Per rail leaf: 12.8 Tb/s down + 12.8 Tb/s up in nominal port capacity. Same rail stays L2; cross-rail uses leaf → spine → leaf." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=22;fontColor=#53657E;fontStyle=0;fontFamily=Arial;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="65" y="1550" width="2240" height="32.16" as="geometry" />
        </mxCell>
        <mxCell id="item-131" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E9;strokeColor=#DEC59B;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="40" y="1610" width="2320" height="78" as="geometry" />
        </mxCell>
        <mxCell id="item-132" value="TO FINALIZE" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=19;fontColor=#91652A;fontStyle=1;fontFamily=Arial;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="60" y="1625" width="131.31" height="28.32" as="geometry" />
        </mxCell>
        <mxCell id="item-133" value="FE/OOB addresses, VLANs, VNIs and ASNs · FE uplink ports" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=21;fontColor=#172B4D;fontStyle=0;fontFamily=Arial;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="228" y="1625" width="2090" height="30.88" as="geometry" />
        </mxCell>
        <mxCell id="item-134" value="Links are bundled for readability. Rates are design values. Backend PFC (priority 3) + ECN as in the production switch configuration (AI-Leaf / AI-Spine ECN_PFC_Lossless)." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=18;fontColor=#53657E;fontStyle=0;fontFamily=Arial;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="228" y="1657" width="2070" height="27.04" as="geometry" />
        </mxCell>
        <mxCell id="item-135" edge="1" parent="1" style="endArrow=none;startArrow=none;strokeColor=#CCD6E2;strokeWidth=1;rounded=0;">
          <mxGeometry relative="1" as="geometry">
