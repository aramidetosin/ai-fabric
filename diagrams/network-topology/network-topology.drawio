        <mxCell id="item-264" value="Eth1/1–6 → ctrl1–6     Eth1/7 → bastion&lt;br&gt;Eth1/8–9 → flashblade-1     Eth1/10–11 → flashblade-2&lt;br&gt;Eth1/12 (proposed) → flashblade-1 mgmt on leaf1, -2 on leaf2; 1G via QSA" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=22;fontColor=#53657E;fontStyle=0;fontFamily=Arial;spacing=0;" vertex="1" parent="1">
