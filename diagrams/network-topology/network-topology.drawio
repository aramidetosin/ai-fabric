        <mxCell id="item-266" value="eth0–15 → 2 × 400G breakout; 32 servers&lt;br&gt;eth16–47 → spare&lt;br&gt;eth48–51 → spine1     eth52–55 → spine2&lt;br&gt;eth56–59 → spine3     eth60–63 → spine4" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=22;fontColor=#53657E;fontStyle=0;fontFamily=Arial;spacing=0;" vertex="1" parent="1">
